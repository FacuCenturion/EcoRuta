# Copiá este archivo con el nombre .env.local y completá la clave.
# El archivo .env.local no se sube a GitHub.
# Si queda vacía, la página usa un mapa alternativo (OpenStreetMap).
VITE_GOOGLE_MAPS_API_KEY=

# Dirección de la API del backend (carpeta backend/). Si queda vacía, el panel usa
# datos simulados en el navegador, como en las Sprints 1 y 2.
# Para usar el backend local: VITE_API_URL=http://localhost:8080/api/v1
VITE_API_URL=
